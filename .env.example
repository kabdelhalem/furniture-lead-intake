# Copy to .env and fill in to record live model responses.
# The corpus eval and demo REPLAY from cache/llm/ and need no key.

# Only required when LLM_MODE=record or LLM_MODE=live.
ANTHROPIC_API_KEY=

# replay (default) | record | live
#   replay: cache only; a miss is an error. Offline, reproducible.
#   record: replay on hit, live call + cache write on miss. Needs a key.
#   live:   always call live; never touch the cache. Needs a key.
LLM_MODE=replay

# Where recorded responses live (committed so eval runs offline).
LLM_CACHE_DIR=cache/llm
